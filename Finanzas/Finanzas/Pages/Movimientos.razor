@page "/movimientos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Finanzas.Models.Operacion

<PageTitle>Movimientos - Finexa</PageTitle>

<div class="pagina-encabezado">
    <span class="pagina-encabezado-icono" aria-hidden="true"><IconoNav Nombre="analisis" Tamano="28" /></span>
    <div>
        <h1>Movimientos</h1>
        <p>Consulta y administra tus movimientos financieros</p>
    </div>
</div>

<div class="kpis">
    <div class="kpi kpi-ingreso">
        <span class="kpi-icono"><IconoNav Nombre="flecha-abajo" Tamano="24" /></span>
        <div>
            <div class="kpi-etiqueta">Ingresos del mes</div>
            <div class="kpi-valor">@(resumen == null ? "—" : Moneda(resumen.Ingresos))</div>
            <div class="kpi-nota">@NombreMes()</div>
        </div>
    </div>
    <div class="kpi kpi-gasto">
        <span class="kpi-icono"><IconoNav Nombre="flecha-arriba" Tamano="24" /></span>
        <div>
            <div class="kpi-etiqueta">Gastos del mes</div>
            <div class="kpi-valor">@(resumen == null ? "—" : Moneda(resumen.Gastos))</div>
            <div class="kpi-nota">@NombreMes()</div>
        </div>
    </div>
    <div class="kpi kpi-saldo">
        <span class="kpi-icono"><IconoNav Nombre="cuentas" Tamano="24" /></span>
        <div>
            <div class="kpi-etiqueta">Saldo actual</div>
            <div class="kpi-valor">@(resumen == null ? "—" : Moneda(resumen.DineroPropio))</div>
            <div class="kpi-nota">Efectivo y débito</div>
        </div>
    </div>
    <div class="kpi kpi-credito">
        <span class="kpi-icono"><IconoNav Nombre="presupuestos" Tamano="24" /></span>
        <div>
            <div class="kpi-etiqueta">Crédito disponible</div>
            <div class="kpi-valor">@(resumen == null ? "—" : Moneda(resumen.CreditoDisponible))</div>
            <div class="kpi-nota">No es dinero propio</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@error</span>
        <button class="btn btn-sm btn-outline-danger" @onclick="Recargar">Reintentar</button>
    </div>
}

<div class="card mov-filtros">
    <div class="card-body">
        <div class="mov-filtros-grid">
            <div class="mov-buscar">
                <label class="visually-hidden" for="f-buscar">Buscar movimiento</label>
                <div class="campo-icono">
                    <IconoNav Nombre="buscar" Tamano="18" />
                    <input id="f-buscar" type="search" class="form-control" placeholder="Buscar movimiento..." @bind="busqueda" @bind:event="oninput" autocomplete="off" />
                </div>
            </div>
            <div>
                <label class="form-label small mb-1" for="f-tipo">Tipo</label>
                <select id="f-tipo" class="form-select" @bind="tipo" @bind:after="Recargar">
                    <option value="">Todos</option>
                    <option value="@TipoOperacion.Gasto">Gasto</option>
                    <option value="@TipoOperacion.Ingreso">Ingreso</option>
                    <option value="@TipoOperacion.Transferencia">Transferencia</option>
                    <option value="@TipoOperacion.PagoTarjeta">Pago de tarjeta</option>
                    <option value="@TipoOperacion.PrestamoOtorgado">Préstamo otorgado</option>
                    <option value="@TipoOperacion.DeudaAdquirida">Deuda adquirida</option>
                    <option value="@TipoOperacion.CobroPrestamo">Abono recibido</option>
                    <option value="@TipoOperacion.PagoDeudaPersona">Pago de deuda</option>
                </select>
            </div>
            <div>
                <label class="form-label small mb-1" for="f-cuenta">Cuenta</label>
                <select id="f-cuenta" class="form-select" @bind="cuentaId" @bind:after="Recargar">
                    <option value="">Todas</option>
                    @foreach (var c in cuentas)
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label small mb-1" for="f-cat">Categoría</label>
                <select id="f-cat" class="form-select" @bind="categoriaId" @bind:after="Recargar">
                    <option value="">Todas</option>
                    @foreach (var c in categorias)
                    {
                        <option value="@c.Id">@c.NombreCompleto</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label small mb-1" for="f-mes">Mes</label>
                <input id="f-mes" type="month" class="form-control" value="@mes" @onchange="CambiarMes" max="@DateTime.Today.ToString("yyyy-MM")" />
            </div>
            <button class="btn btn-primary mov-agregar" @onclick="Nuevo">
                <IconoNav Nombre="agregar" Tamano="18" /> Agregar
            </button>
        </div>
    </div>
</div>

<div class="card mov-panel">
    <div class="card-body">
        <div class="mov-tabs" role="group" aria-label="Filtrar por grupo de movimientos">
            <button type="button" class="mov-tab @(pestana == "todos" ? "activa" : "")" aria-pressed="@(pestana == "todos")" @onclick='() => pestana = "todos"'><IconoNav Nombre="todos" Tamano="18" /> Todos</button>
            <button type="button" class="mov-tab @(pestana == "ingresos" ? "activa" : "")" aria-pressed="@(pestana == "ingresos")" @onclick='() => pestana = "ingresos"'><IconoNav Nombre="flecha-abajo" Tamano="18" /> Ingresos</button>
            <button type="button" class="mov-tab @(pestana == "gastos" ? "activa" : "")" aria-pressed="@(pestana == "gastos")" @onclick='() => pestana = "gastos"'><IconoNav Nombre="flecha-arriba" Tamano="18" /> Gastos</button>
            <button type="button" class="mov-tab @(pestana == "prestamos" ? "activa" : "")" aria-pressed="@(pestana == "prestamos")" @onclick='() => pestana = "prestamos"'><IconoNav Nombre="personas" Tamano="18" /> Préstamos</button>
            <button type="button" class="mov-tab @(pestana == "deudas" ? "activa" : "")" aria-pressed="@(pestana == "deudas")" @onclick='() => pestana = "deudas"'><IconoNav Nombre="cuentas" Tamano="18" /> Deudas</button>
        </div>

        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
            </div>
        }
        else if (operaciones.Count == 0)
        {
            <div class="estado-vacio">No hay movimientos para mostrar.</div>
        }
        else if (Visibles.Count == 0)
        {
            <div class="estado-vacio">Ningún movimiento coincide con tu búsqueda o con la pestaña elegida.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle bg-white table-cards">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Descripción</th>
                            <th>Categoría</th>
                            <th>Cuenta</th>
                            <th class="text-end">Monto</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Visibles)
                        {
                            <tr>
                                <td class="text-nowrap" data-label="Fecha">@o.Fecha.ToString("dd/MM/yyyy")</td>
                                <td data-label="Tipo"><span class="badge tipo-badge @ClaseTipo(o.TipoOperacion)"><IconoNav Nombre="@IconoTipo(o.TipoOperacion)" Tamano="14" /> @NombreTipo(o.TipoOperacion)</span></td>
                                <td class="fw-semibold">@(string.IsNullOrWhiteSpace(o.Descripcion) ? "—" : o.Descripcion)@if (o.Msi != null) {<span class="badge bg-info text-dark ms-1">@o.Msi.NumeroMeses MSI</span>}@if (o.PersonaNombre != null) {<span class="small text-muted fw-normal ms-1">· @o.PersonaNombre</span>}</td>
                                <td data-label="Categoría">@(o.CategoriaNombre ?? "—")</td>
                                <td data-label="Cuenta">@Cuentas(o)</td>
                                <td class="text-end text-nowrap @ClaseMonto(o.TipoOperacion)" data-label="Monto">@Monto(o)</td>
                                <td class="text-end text-nowrap acciones">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Copiar(o)" title="Copiar" aria-label="Copiar"><IconoAccion Nombre="copiar" /></button>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Editar(o)" title="Editar" aria-label="Editar"><IconoAccion Nombre="editar" /></button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirEliminar(o)" title="Eliminar" aria-label="Eliminar"><IconoAccion Nombre="eliminar" /></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mov-pie">
                <span class="text-muted small" aria-live="polite">
                    Mostrando <strong>@Visibles.Count</strong> @(Visibles.Count != operaciones.Count ? $"de {operaciones.Count} movimientos cargados" : (Visibles.Count == 1 ? "movimiento" : "movimientos"))@(hayMas ? " · hay más por cargar" : "")
                </span>
                @if (hayMas)
                {
                    <button class="btn btn-outline-primary" @onclick="CargarMas" disabled="@cargandoMas">
                        @if (cargandoMas)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        Cargar más
                    </button>
                }
            </div>
        }
    </div>
</div>

@if (formAbierto)
{
    <MovimientoForm Operacion="enEdicion" Copiar="copiando" OnGuardado="Guardado" OnCancelado="CerrarForm" />
}

@if (aEliminar != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar movimiento</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0">¿Eliminar @NombreTipo(aEliminar.TipoOperacion).ToLower() de @Moneda(aEliminar.Monto) del @aEliminar.Fecha.ToString("dd/MM/yyyy")? Los saldos de las cuentas se revertirán.</p>
                    @if (!string.IsNullOrEmpty(errorEliminar))
                    {
                        <div class="alert alert-danger py-2 mt-3 mb-0" role="alert">@errorEliminar</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="() => aEliminar = null" disabled="@eliminando">Cancelar</button>
                    <button class="btn btn-danger" @onclick="Eliminar" disabled="@eliminando">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}
