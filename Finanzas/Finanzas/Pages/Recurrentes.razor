@page "/recurrentes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Finanzas.Models.Operacion
@using Finanzas.Models.Recurrente

<PageTitle>Recurrentes - Finanzas</PageTitle>

<div class="page-header">
    <div>
        <h1>Recurrentes</h1>
        <div class="text-muted small">Gastos e ingresos que se repiten. Al llegar la fecha te aparecen para confirmar.</div>
    </div>
    <button class="btn btn-primary" @onclick="Nueva">+ Nueva recurrente</button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@error</span>
        <button class="btn btn-sm btn-outline-danger" @onclick="Cargar">Reintentar</button>
    </div>
}

<PendientesRecurrentes @key="versionPendientes" OnCambio="Cargar" />

<div class="form-check form-switch mb-3">
    <input class="form-check-input" type="checkbox" id="inactivas" @bind="mostrarInactivas" />
    <label class="form-check-label" for="inactivas">Mostrar inactivas</label>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else if (Visibles.Count == 0)
{
    <div class="text-center text-muted py-5">No hay recurrentes para mostrar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white table-cards">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th>Tipo</th>
                    <th class="text-end">Monto</th>
                    <th>Cuenta</th>
                    <th>Frecuencia</th>
                    <th>Próxima fecha</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Visibles)
                {
                    <tr class="@(r.Activa ? null : "text-muted")">
                        <td class="fw-semibold">
                            @r.Descripcion
                            @if (!string.IsNullOrEmpty(r.CategoriaNombre))
                            {
                                <div class="small text-muted fw-normal">@r.CategoriaNombre</div>
                            }
                        </td>
                        <td data-label="Tipo"><span class="badge @(r.TipoOperacion == TipoOperacion.Ingreso ? "bg-success" : "bg-secondary")">@r.TipoOperacion</span></td>
                        <td class="text-end" data-label="Monto">@Moneda(r.Monto)</td>
                        <td data-label="Cuenta">@r.CuentaNombre</td>
                        <td data-label="Frecuencia">@FrecuenciaRecurrente.Nombre(r.Frecuencia)</td>
                        <td data-label="Próxima fecha">
                            @r.ProximaFecha.ToString("dd/MM/yyyy")
                            @if (Terminada(r))
                            {
                                <span class="badge bg-secondary ms-1">Terminada</span>
                            }
                            else if (r.Activa && r.ProximaFecha.Date <= DateTime.Today)
                            {
                                <span class="badge bg-warning text-dark ms-1">Pendiente</span>
                            }
                        </td>
                        <td data-label="Estado">
                            <span class="badge @(r.Activa ? "bg-success" : "bg-secondary")">@(r.Activa ? "Activa" : "Inactiva")</span>
                        </td>
                        <td class="text-end text-nowrap acciones">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Editar(r)" title="Editar" aria-label="Editar"><IconoAccion Nombre="editar" /></button>
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => CambiarEstado(r)" title="@(r.Activa ? "Desactivar" : "Activar")" aria-label="@(r.Activa ? "Desactivar" : "Activar")"><IconoAccion Nombre="estado" /></button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirEliminar(r)" title="Eliminar" aria-label="Eliminar"><IconoAccion Nombre="eliminar" /></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (modalAbierto)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
            <div class="modal-content">
                <EditForm Model="form" OnSubmit="Guardar">
                    <div class="modal-header">
                        <h5 class="modal-title">@(editando ? "Editar recurrente" : "Nueva recurrente")</h5>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarModal" disabled="@guardando"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="rec-tipo">Tipo</label>
                            <InputSelect id="rec-tipo" class="form-select" Value="form.TipoOperacion" ValueChanged="@((string t) => CambiarTipo(t))" ValueExpression="@(() => form.TipoOperacion)" disabled="@guardando">
                                <option value="@TipoOperacion.Gasto">Gasto</option>
                                <option value="@TipoOperacion.Ingreso">Ingreso</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="rec-desc">Descripción</label>
                            <InputText id="rec-desc" class="form-control" @bind-Value="form.Descripcion" maxlength="250" placeholder="Ej. Renta, Netflix, Nómina" disabled="@guardando" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="rec-monto">Monto</label>
                            <InputNumber id="rec-monto" class="form-control" @bind-Value="form.Monto" disabled="@guardando" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="rec-cuenta">@(form.TipoOperacion == TipoOperacion.Ingreso ? "Cuenta donde entra" : "Cuenta de la que sale")</label>
                            <InputSelect id="rec-cuenta" class="form-select" @bind-Value="form.CuentaId" disabled="@guardando">
                                <option value="0">Selecciona...</option>
                                @foreach (var c in CuentasDisponibles)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="rec-cat">Categoría</label>
                            <InputSelect id="rec-cat" class="form-select" @bind-Value="form.CategoriaId" disabled="@guardando">
                                <option value="">Sin categoría</option>
                                @foreach (var c in CategoriasDisponibles)
                                {
                                    <option value="@c.Id">@c.NombreCompleto</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="rec-frec">Frecuencia</label>
                            <InputSelect id="rec-frec" class="form-select" @bind-Value="form.Frecuencia" disabled="@guardando">
                                @foreach (var f in Frecuencias)
                                {
                                    <option value="@f.Clave">@f.Descripcion</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="rec-fecha">@(editando ? "Próxima fecha" : "Primera fecha")</label>
                            <InputDate id="rec-fecha" class="form-control" @bind-Value="form.ProximaFecha" disabled="@guardando" />
                            <div class="form-text">Si es mensual o anual, el día de esta fecha es el que se repite (el 31 cae el último día en meses cortos).</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="rec-fin">Termina el (opcional)</label>
                            <InputDate id="rec-fin" class="form-control" @bind-Value="form.FechaFin" disabled="@guardando" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorForm))
                        {
                            <div class="alert alert-danger py-2 mb-0" role="alert">@errorForm</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModal" disabled="@guardando">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (aEliminar != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar recurrente</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0">¿Eliminar "@aEliminar.Descripcion"? Los movimientos que ya confirmaste se conservan.</p>
                    @if (!string.IsNullOrEmpty(errorEliminar))
                    {
                        <div class="alert alert-danger py-2 mt-3 mb-0" role="alert">@errorEliminar</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="() => aEliminar = null" disabled="@eliminando">Cancelar</button>
                    <button class="btn btn-danger" @onclick="Eliminar" disabled="@eliminando">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}
