@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Finanzas.Models.Dashboard

<PageTitle>Inicio - Finexa</PageTitle>

<div class="pagina-encabezado">
    <span class="pagina-encabezado-icono" aria-hidden="true"><IconoNav Nombre="grafica" Tamano="28" /></span>
    <div>
        <h1>¡Hola, @Nombre!</h1>
        <p>Aquí tienes un resumen de tus finanzas</p>
    </div>
    <span class="inicio-fecha"><IconoNav Nombre="reloj" Tamano="18" /> @FechaHoy</span>
</div>

<div class="d-flex align-items-center justify-content-center gap-2 mb-3">
    <button class="btn btn-sm btn-outline-primary" @onclick="() => CambiarMes(-1)" aria-label="Mes anterior" disabled="@cargando">&lsaquo;</button>
    <div class="mes-actual">@NombreMes(mes, anio)</div>
    <button class="btn btn-sm btn-outline-primary" @onclick="() => CambiarMes(1)" aria-label="Mes siguiente" disabled="@(cargando || EsMesActual)">&rsaquo;</button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@error</span>
        <button class="btn btn-sm btn-outline-danger" @onclick="Cargar">Reintentar</button>
    </div>
}

@if (cargando && datos == null)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else if (datos != null)
{
    foreach (var pago in datos.PagosTarjeta)
    {
        <div class="alert @(pago.Vencido ? "alert-danger" : pago.DiasRestantes <= 5 ? "alert-warning" : "alert-info") py-2 d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
            <span>
                <strong>@pago.Nombre:</strong> paga @Moneda(pago.Pendiente) para no generar intereses.
                @if (pago.Vencido)
                {
                    <span>Venció el @pago.FechaLimite.ToString("dd/MM/yyyy").</span>
                }
                else
                {
                    <span>Fecha límite: @pago.FechaLimite.ToString("dd/MM/yyyy") (@(pago.DiasRestantes == 0 ? "hoy" : pago.DiasRestantes == 1 ? "mañana" : $"en {pago.DiasRestantes} días")).</span>
                }
            </span>
            <span class="d-flex gap-2">
                <button class="btn btn-sm btn-success" @onclick="() => MarcarPagado(pago.CuentaId)">Ya pagué</button>
                <a class="btn btn-sm btn-outline-secondary" href="cuentas/@pago.CuentaId">Ver tarjeta</a>
            </span>
        </div>
    }

    <PendientesRecurrentes OnCambio="Cargar" />

    <div class="kpis kpis-3">
        <div class="kpi kpi-saldo">
            <span class="kpi-icono"><IconoNav Nombre="cuentas" Tamano="24" /></span>
            <div>
                <div class="kpi-etiqueta">Saldo disponible</div>
                <div class="kpi-valor">@Moneda(datos.DineroPropio)</div>
                <div class="kpi-nota">Efectivo y débito</div>
            </div>
        </div>
        <div class="kpi kpi-credito">
            <span class="kpi-icono"><IconoNav Nombre="tarjeta" Tamano="24" /></span>
            <div>
                <div class="kpi-etiqueta">Crédito disponible</div>
                <div class="kpi-valor">@Moneda(datos.CreditoDisponible)</div>
                <div class="kpi-nota">@(datos.LimiteCreditoTotal > 0 ? $"Límite: {Moneda(datos.LimiteCreditoTotal)} · no es dinero propio" : "No es dinero propio")</div>
            </div>
        </div>
        <div class="kpi kpi-gasto">
            <span class="kpi-icono"><IconoNav Nombre="presupuestos" Tamano="24" /></span>
            <div>
                <div class="kpi-etiqueta">Deuda en tarjetas</div>
                <div class="kpi-valor">@Moneda(datos.DeudaTarjetas)</div>
                <div class="kpi-nota">@(datos.LimiteCreditoTotal > 0 ? $"de {Moneda(datos.LimiteCreditoTotal)} de límite" : "Sin tarjetas con límite")</div>
            </div>
        </div>
    </div>

    <div class="inicio-grid">
        <section class="card">
            <div class="card-body">
                <div class="cta-titulo">
                    <h2 class="seccion-titulo"><IconoNav Nombre="grafica" Tamano="20" /> Resumen financiero</h2>
                    <span class="small text-muted">Últimos @datos.Meses.Count meses</span>
                </div>

                <div class="inicio-mes-cifras">
                    <div>
                        <span class="kpi-etiqueta">Ingresos del mes</span>
                        <strong class="text-success">@Moneda(datos.Ingresos)</strong>
                    </div>
                    <div>
                        <span class="kpi-etiqueta">Gastos del mes</span>
                        <strong class="text-danger">@Moneda(datos.Gastos)</strong>
                    </div>
                    <div>
                        <span class="kpi-etiqueta">Diferencia</span>
                        <strong class="@(datos.Diferencia >= 0 ? "text-success" : "text-danger")">@Moneda(datos.Diferencia)</strong>
                    </div>
                </div>

                <div class="barras">
                    @foreach (var m in datos.Meses)
                    {
                        var esActual = m == datos.Meses[^1];
                        <div class="barras-mes @(esActual ? "actual" : null)">
                            <div class="barras-par">
                                <div class="barra ingreso" style="height:@Altura(m.Ingresos)%" title="Ingresos @Moneda(m.Ingresos)"></div>
                                <div class="barra gasto" style="height:@Altura(m.Gastos)%" title="Gastos @Moneda(m.Gastos)"></div>
                            </div>
                            <div class="barras-etiqueta">@NombreMesCorto(m.Mes)</div>
                        </div>
                    }
                </div>
                <div class="d-flex gap-3 justify-content-center small text-muted mt-2">
                    <span><span class="punto" style="background:var(--fz-verde)"></span> Ingresos</span>
                    <span><span class="punto" style="background:var(--fz-gasto)"></span> Gastos</span>
                </div>
            </div>
        </section>

        <section class="consejo">
            <h2 class="consejo-titulo"><IconoNav Nombre="grafica" Tamano="22" /> Consejo de Finexa</h2>
            <p class="consejo-texto">@Consejo()</p>
            <a href="analisis" class="consejo-enlace">Ver análisis <span aria-hidden="true">→</span></a>
        </section>
    </div>

    <div class="inicio-grid">
        <div class="inicio-columna">
            <section class="card">
                <div class="card-body">
                    <h2 class="seccion-titulo"><IconoNav Nombre="agregar" Tamano="20" /> Accesos rápidos</h2>
                    <div class="accesos">
                        <button type="button" class="acceso acceso-1" @onclick="() => movimientoAbierto = true">
                            <IconoNav Nombre="movimientos" Tamano="30" />
                            <span>Agregar movimiento</span>
                        </button>
                        <a class="acceso acceso-2" href="analisis">
                            <IconoNav Nombre="analisis" Tamano="30" />
                            <span>Ver análisis</span>
                        </a>
                        <a class="acceso acceso-3" href="presupuestos">
                            <IconoNav Nombre="presupuestos" Tamano="30" />
                            <span>Configurar presupuesto</span>
                        </a>
                        <a class="acceso acceso-4" href="cuentas">
                            <IconoNav Nombre="cuentas" Tamano="30" />
                            <span>Administrar cuentas</span>
                        </a>
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-body">
                    <h2 class="seccion-titulo">Gastos por categoría</h2>
                    @if (datos.GastosPorCategoria.Count == 0)
                    {
                        <div class="text-muted py-4 text-center">Sin gastos registrados en este mes.</div>
                    }
                    else
                    {
                        <div class="dona-fila">
                            <svg viewBox="0 0 42 42" class="dona" role="img" aria-label="Gastos por categoría">
                                <circle cx="21" cy="21" r="15.9155" fill="none" style="stroke:var(--fz-borde)" stroke-width="6"></circle>
                                @{ var acumulado = 0m; }
                                @for (var i = 0; i < datos.GastosPorCategoria.Count; i++)
                                {
                                    var g = datos.GastosPorCategoria[i];
                                    var porcentaje = datos.Gastos == 0 ? 0 : g.Monto / datos.Gastos * 100;
                                    <circle cx="21" cy="21" r="15.9155" fill="none" style="stroke:@Color(i)" stroke-width="6"
                                            stroke-dasharray="@Num(porcentaje) @Num(100 - porcentaje)"
                                            stroke-dashoffset="@Num(25 - acumulado)"></circle>
                                    acumulado += porcentaje;
                                }
                            </svg>
                            <ul class="leyenda">
                                @for (var i = 0; i < datos.GastosPorCategoria.Count; i++)
                                {
                                    var g = datos.GastosPorCategoria[i];
                                    <li>
                                        <span class="punto" style="background:@Color(i)"></span>
                                        <span class="leyenda-nombre">@g.Nombre</span>
                                        <span class="leyenda-valor">@Moneda(g.Monto) <small class="text-muted">@g.Porcentaje.ToString("0.#")%</small></span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="inicio-columna">
            <section class="card">
                <div class="card-body">
                    <div class="cta-titulo">
                        <h2 class="seccion-titulo"><IconoNav Nombre="reloj" Tamano="20" /> Movimientos recientes</h2>
                        <a href="movimientos" class="cta-enlace">Ver todos →</a>
                    </div>
                    @if (recientes.Count == 0)
                    {
                        <div class="estado-vacio">Aún no hay movimientos.</div>
                    }
                    else
                    {
                        <ul class="cta-lista">
                            @foreach (var o in recientes)
                            {
                                <li>
                                    <span class="cta-lista-icono @ClaseMonto(o.TipoOperacion)"><IconoNav Nombre="@IconoTipo(o.TipoOperacion)" Tamano="18" /></span>
                                    <div class="cta-lista-texto">
                                        <strong>@TituloReciente(o)</strong>
                                        <span>@o.Fecha.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <span class="cta-lista-monto @ClaseMonto(o.TipoOperacion)">@MontoReciente(o)</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>

            @if (datos.Presupuestos.Items.Count > 0)
            {
                <section class="card">
                    <div class="card-body">
                        <div class="cta-titulo">
                            <h2 class="seccion-titulo">Presupuestos del mes</h2>
                            <a href="presupuestos" class="cta-enlace">Administrar →</a>
                        </div>
                        <div class="d-grid gap-3">
                            @foreach (var item in datos.Presupuestos.Items.Take(4))
                            {
                                <BarraPresupuesto Item="item" />
                            }
                        </div>
                        @if (datos.Presupuestos.Items.Count > 4)
                        {
                            <div class="small text-muted mt-2">Se muestran los 4 con más avance de @datos.Presupuestos.Items.Count.</div>
                        }
                    </div>
                </section>
            }
        </div>
    </div>

    <div class="card mb-3"><div class="card-body">
        <h2 class="seccion-titulo">Salud financiera</h2>
        <div class="row g-3">
            @foreach (var ind in datos.Indicadores)
            {
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="indicador nivel-@ind.Nivel">
                        <div class="indicador-nombre">@ind.Nombre</div>
                        <div class="indicador-valor">@ind.Valor</div>
                        <div class="indicador-detalle">@ind.Detalle</div>
                    </div>
                </div>
            }
        </div>
    </div></div>
}

@if (movimientoAbierto)
{
    <MovimientoForm OnGuardado="Guardado" OnCancelado="() => movimientoAbierto = false" />
}
