@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Inicio - Finanzas</PageTitle>

<div class="card inicio-bienvenida border-0 mb-4">
    <div class="card-body d-flex flex-column flex-sm-row align-items-center gap-3 p-4">
        <img src="Logo.png" alt="Logo de Finanzas" class="inicio-logo" />
        <div class="text-center text-sm-start">
            <h1 class="mb-1">Hola, @Nombre</h1>
            <p class="mb-0 text-muted">Lleva el control de tu dinero: cuentas, categorías y personas en un solo lugar.</p>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <a href="cuentas" class="card inicio-acceso h-100 text-decoration-none">
            <div class="card-body">
                <div class="inicio-acceso-titulo">Cuentas</div>
                <div class="text-muted small">Efectivo, débito y tarjetas de crédito.</div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a href="categorias" class="card inicio-acceso h-100 text-decoration-none">
            <div class="card-body">
                <div class="inicio-acceso-titulo">Categorías</div>
                <div class="text-muted small">Ingresos y gastos para clasificar tu dinero.</div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a href="personas" class="card inicio-acceso h-100 text-decoration-none">
            <div class="card-body">
                <div class="inicio-acceso-titulo">Personas</div>
                <div class="text-muted small">Con quién compartes préstamos y deudas.</div>
            </div>
        </a>
    </div>
</div>
