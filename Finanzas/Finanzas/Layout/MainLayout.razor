@inherits LayoutComponentBase

<a href="@(Navigation.Uri)#contenido" class="saltar-contenido" @onclick:preventDefault @onclick="IrAlContenido">Saltar al contenido</a>

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <header class="top-row">
            <a href="" class="marca-movil" aria-label="Finexa">
                <img src="finexa-logo.png" alt="Finexa" class="logo-claro" />
                <img src="finexa-logo-oscuro.png" alt="Finexa" class="logo-oscuro" />
            </a>
            <AuthorizeView>
                <button type="button" class="btn btn-primary btn-agregar-top" @onclick="() => agregarAbierto = true">
                    <IconoNav Nombre="agregar" Tamano="16" /> Agregar
                </button>
                <div class="usuario">
                    <span class="avatar" aria-hidden="true">@Inicial(context.User.Identity?.Name)</span>
                    <span class="nombre">@context.User.Identity?.Name</span>
                </div>
                <button class="btn btn-sm btn-outline-primary btn-salir" @onclick="CerrarSesion">Salir</button>
            </AuthorizeView>
        </header>

        <article class="content" id="contenido" tabindex="-1" @key="refresco">
            @Body
        </article>
    </main>

    <NavInferior OnAgregar="() => agregarAbierto = true" OnSalir="CerrarSesion" />
</div>

@if (agregarAbierto)
{
    <MovimientoForm OnGuardado="MovimientoGuardado" OnCancelado="() => agregarAbierto = false" />
}
